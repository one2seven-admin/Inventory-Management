PORT=4005
# Each service uses the same Postgres database with its own schema namespace
# for data-ownership isolation (?schema=<service name>).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&schema=notifications"
# Server-to-server base URL for inventory-service, whose read endpoints back
# the low-stock / expiry alert detection functions.
INVENTORY_SERVICE_URL=http://localhost:4002
