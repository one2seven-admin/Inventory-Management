PORT=4004
# Each service uses the same Postgres database with its own schema namespace
# for data-ownership isolation (?schema=<service name>).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&schema=recipes"
# Base URL of inventory-service, called server-to-server for item lookups and
# stock issue postings (recipe ingredient costing + POS/manual deduction).
INVENTORY_SERVICE_URL="http://localhost:4002"
# Shared secret POS integrations must send as `x-pos-api-key` when calling
# POST /sales-events. This webhook has no user JWT (no browser session), so
# this header is its only authentication.
POS_WEBHOOK_SECRET="dev-pos-secret-change-me"
