PORT=4001
# Each service uses the same Postgres database with its own schema namespace
# for data-ownership isolation (?schema=<service name>).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&schema=identity"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
