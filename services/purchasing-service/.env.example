PORT=4003
# Each service uses the same Postgres database with its own schema namespace
# for data-ownership isolation (?schema=<service name>).
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&schema=purchasing"
# Server-to-server base URL for inventory-service (item lookups, stock
# levels/below-par, and posting received goods to the stock ledger).
INVENTORY_SERVICE_URL="http://localhost:4002"
