PORT=4000
# Must match identity-service's JWT_ACCESS_SECRET — the gateway verifies
# tokens that identity-service issued.
JWT_ACCESS_SECRET="dev-access-secret-change-me"

IDENTITY_SERVICE_URL="http://localhost:4001"
INVENTORY_SERVICE_URL="http://localhost:4002"
PURCHASING_SERVICE_URL="http://localhost:4003"
RECIPES_SERVICE_URL="http://localhost:4004"
NOTIFICATIONS_SERVICE_URL="http://localhost:4005"
REPORTING_SERVICE_URL="http://localhost:4006"
