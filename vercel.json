{
    "services": {
        "web": {
            "root": "apps/web",
            "framework": "nextjs",
            "bindings": [
                { "type": "service", "service": "gateway", "format": "url", "env": "GATEWAY_URL" }
            ]
        },
        "gateway": {
            "root": "apps/gateway",
            "entrypoint": "src/server.ts",
            "bindings": [
                { "type": "service", "service": "identity-service", "format": "url", "env": "IDENTITY_SERVICE_URL" },
                { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" },
                { "type": "service", "service": "purchasing-service", "format": "url", "env": "PURCHASING_SERVICE_URL" },
                { "type": "service", "service": "recipes-service", "format": "url", "env": "RECIPES_SERVICE_URL" },
                { "type": "service", "service": "notifications-service", "format": "url", "env": "NOTIFICATIONS_SERVICE_URL" },
                { "type": "service", "service": "reporting-service", "format": "url", "env": "REPORTING_SERVICE_URL" }
            ]
        },
        "identity-service": {
            "root": "services/identity-service",
            "entrypoint": "src/server.ts"
        },
        "inventory-service": {
            "root": "services/inventory-service",
            "entrypoint": "src/server.ts"
        },
        "notifications-service": {
            "root": "services/notifications-service",
            "entrypoint": "src/server.ts",
            "bindings": [
                { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" }
            ]
        },
        "purchasing-service": {
            "root": "services/purchasing-service",
            "entrypoint": "src/server.ts",
            "bindings": [
                { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" }
            ]
        },
        "recipes-service": {
            "root": "services/recipes-service",
            "entrypoint": "src/server.ts",
            "bindings": [
                { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" }
            ]
        },
        "reporting-service": {
            "root": "services/reporting-service",
            "entrypoint": "src/server.ts",
            "bindings": [
                { "type": "service", "service": "inventory-service", "format": "url", "env": "INVENTORY_SERVICE_URL" },
                { "type": "service", "service": "purchasing-service", "format": "url", "env": "PURCHASING_SERVICE_URL" },
                { "type": "service", "service": "recipes-service", "format": "url", "env": "RECIPES_SERVICE_URL" }
            ]
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": { "service": "gateway" }
        },
        {
            "source": "/(.*)",
            "destination": { "service": "web" }
        }
    ]
}
